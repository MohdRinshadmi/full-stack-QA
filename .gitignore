# ---- Dependencies ----
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz

# ---- Generated output ----
# Everything in build/ is regenerated by:
#   node build.js && node build-parts.js && node render.js …
# The PDFs are ~45MB and get a fresh binary blob on every rebuild (PDFs don't
# delta-compress), so tracking them bloats the repo fast.
# To version the finished PDFs anyway, replace `build/*` with `build/*.html`.
# NB: ignore the CONTENTS (build/*), not the directory (build/), or the
# .gitkeep negation below cannot work and a fresh clone has no build/ dir.
build/*
!build/.gitkeep

# ---- Logs & debug ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
report.*.json

# ---- Environment & secrets ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.history/

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Scratch / temp ----
tmp/
temp/
*.tmp
*.bak
*.orig
scratch/
